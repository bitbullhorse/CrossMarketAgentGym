* text=auto
*.py text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.cff text eol=lf
*.lock text eol=lf
*.sh text eol=lf
.gitignore text eol=lf
Dockerfile text eol=lf
*.parquet binary
*.xls binary
*.xlsx binary
*.zip binary
*.whl binary
*.gz binary

# Phase 12 immutable protocol inputs are byte-addressed by SHA-256.
/experiments/** -text -eol whitespace=cr-at-eol

# Phase 13 Benchmark v1 is a byte-addressed, write-once publication artifact.
/benchmarks/v1/** -text -eol whitespace=cr-at-eol
