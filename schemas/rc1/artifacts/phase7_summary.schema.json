{
  "$defs": {
    "AdministratorRiskPolicy": {
      "additionalProperties": false,
      "description": "Immutable absolute risk limits owned outside every LLM.",
      "properties": {
        "allow_new_positions": {
          "default": true,
          "title": "Allow New Positions",
          "type": "boolean"
        },
        "default_max_market_weight": {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Default Max Market Weight",
          "type": "number"
        },
        "max_asset_weight": {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Max Asset Weight",
          "type": "number"
        },
        "max_market_weights": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Max Market Weights",
          "type": "object"
        },
        "max_risk_budget": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Max Risk Budget",
          "type": "number"
        },
        "max_turnover": {
          "maximum": 2.0,
          "minimum": 0.0,
          "title": "Max Turnover",
          "type": "number"
        },
        "minimum_cash_floor": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Minimum Cash Floor",
          "type": "number"
        },
        "minimum_rebalance_interval": {
          "default": "daily",
          "enum": [
            "daily",
            "weekly",
            "monthly"
          ],
          "title": "Minimum Rebalance Interval",
          "type": "string"
        }
      },
      "required": [
        "max_asset_weight",
        "default_max_market_weight",
        "minimum_cash_floor",
        "max_turnover"
      ],
      "title": "AdministratorRiskPolicy",
      "type": "object"
    },
    "AgentDecision": {
      "additionalProperties": false,
      "description": "Provider-neutral structured envelope used by every Phase 6 role.",
      "properties": {
        "confidence": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "constraints": {
          "$ref": "#/$defs/DecisionConstraints"
        },
        "decision": {
          "enum": [
            "approve",
            "revise",
            "reject",
            "abstain"
          ],
          "title": "Decision",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "risk_score": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Risk Score",
          "type": "number"
        },
        "summary": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "decision",
        "summary"
      ],
      "title": "AgentDecision",
      "type": "object"
    },
    "AgentExecutionResult": {
      "additionalProperties": false,
      "description": "Auditable outcome of one invocation, including partial failures.",
      "properties": {
        "attempts": {
          "minimum": 1,
          "title": "Attempts",
          "type": "integer"
        },
        "base_name": {
          "title": "Base Name",
          "type": "string"
        },
        "decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentDecision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "duration_seconds": {
          "minimum": 0.0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "error_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Message"
        },
        "instance_id": {
          "title": "Instance Id",
          "type": "string"
        },
        "invocation_id": {
          "title": "Invocation Id",
          "type": "string"
        },
        "role_type": {
          "title": "Role Type",
          "type": "string"
        },
        "round_index": {
          "title": "Round Index",
          "type": "integer"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "status": {
          "enum": [
            "succeeded",
            "fallback",
            "failed",
            "timed_out"
          ],
          "title": "Status",
          "type": "string"
        },
        "weight": {
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "invocation_id",
        "instance_id",
        "role_type",
        "base_name",
        "seed",
        "round_index",
        "weight",
        "status",
        "attempts",
        "duration_seconds"
      ],
      "title": "AgentExecutionResult",
      "type": "object"
    },
    "ConstraintFusionResult": {
      "additionalProperties": false,
      "description": "Proof that Agent budgets only tightened administrator constraints.",
      "properties": {
        "constraints": {
          "$ref": "#/$defs/EffectiveConstraintSet"
        },
        "effective_environment": {
          "$ref": "#/$defs/EnvironmentConfig"
        },
        "hard_environment": {
          "$ref": "#/$defs/EnvironmentConfig"
        },
        "hierarchical": {
          "anyOf": [
            {
              "$ref": "#/$defs/HierarchicalDirective"
            },
            {
              "type": "null"
            }
          ]
        },
        "risk": {
          "$ref": "#/$defs/RiskMergeResult"
        },
        "tightened_fields": {
          "items": {
            "type": "string"
          },
          "title": "Tightened Fields",
          "type": "array"
        }
      },
      "required": [
        "hard_environment",
        "effective_environment",
        "constraints",
        "risk",
        "hierarchical",
        "tightened_fields"
      ],
      "title": "ConstraintFusionResult",
      "type": "object"
    },
    "DecisionConstraints": {
      "additionalProperties": false,
      "description": "Optional structured limits that conservative arbitration can intersect.",
      "properties": {
        "allow_new_positions": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allow New Positions"
        },
        "cash_floor": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cash Floor"
        },
        "max_asset_weight": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Asset Weight"
        },
        "max_market_weights": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Max Market Weights",
          "type": "object"
        },
        "max_turnover": {
          "anyOf": [
            {
              "maximum": 2.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Turnover"
        }
      },
      "title": "DecisionConstraints",
      "type": "object"
    },
    "DirectiveProjection": {
      "additionalProperties": false,
      "description": "Projected DRL action; this object contains no account mutation method.",
      "properties": {
        "clipping_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Clipping Reasons",
          "type": "array"
        },
        "fusion": {
          "$ref": "#/$defs/ConstraintFusionResult"
        },
        "normalized_weights": {
          "items": {
            "type": "number"
          },
          "title": "Normalized Weights",
          "type": "array"
        },
        "projected_weights": {
          "items": {
            "type": "number"
          },
          "title": "Projected Weights",
          "type": "array"
        },
        "raw_action": {
          "items": {
            "type": "number"
          },
          "title": "Raw Action",
          "type": "array"
        },
        "unresolved_constraints": {
          "items": {
            "type": "string"
          },
          "title": "Unresolved Constraints",
          "type": "array"
        }
      },
      "required": [
        "raw_action",
        "normalized_weights",
        "projected_weights",
        "clipping_reasons",
        "unresolved_constraints",
        "fusion"
      ],
      "title": "DirectiveProjection",
      "type": "object"
    },
    "EffectiveConstraintSet": {
      "additionalProperties": false,
      "description": "Resolved constraints supplied to the deterministic projector.",
      "properties": {
        "allow_new_positions": {
          "title": "Allow New Positions",
          "type": "boolean"
        },
        "cash_floor": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Cash Floor",
          "type": "number"
        },
        "max_asset_weight": {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Max Asset Weight",
          "type": "number"
        },
        "max_market_weights": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Max Market Weights",
          "type": "object"
        },
        "max_turnover": {
          "maximum": 2.0,
          "minimum": 0.0,
          "title": "Max Turnover",
          "type": "number"
        },
        "risk_budget": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Risk Budget",
          "type": "number"
        }
      },
      "required": [
        "risk_budget",
        "max_asset_weight",
        "max_market_weights",
        "cash_floor",
        "max_turnover",
        "allow_new_positions"
      ],
      "title": "EffectiveConstraintSet",
      "type": "object"
    },
    "EnvironmentConfig": {
      "additionalProperties": false,
      "description": "Immutable hard constraints and daily execution settings.",
      "properties": {
        "accounting_tolerance": {
          "default": 1e-08,
          "exclusiveMinimum": 0.0,
          "maximum": 0.001,
          "title": "Accounting Tolerance",
          "type": "number"
        },
        "allow_short": {
          "default": false,
          "title": "Allow Short",
          "type": "boolean"
        },
        "base_currency": {
          "default": "USD",
          "title": "Base Currency",
          "type": "string"
        },
        "cash_floor": {
          "default": 0.05,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Cash Floor",
          "type": "number"
        },
        "cvar_alpha": {
          "default": 0.05,
          "exclusiveMinimum": 0.0,
          "maximum": 0.5,
          "title": "Cvar Alpha",
          "type": "number"
        },
        "cvar_penalty": {
          "default": 0.5,
          "minimum": 0.0,
          "title": "Cvar Penalty",
          "type": "number"
        },
        "drawdown_penalty": {
          "default": 0.5,
          "minimum": 0.0,
          "title": "Drawdown Penalty",
          "type": "number"
        },
        "execution_protocol": {
          "const": "close_signal_next_open",
          "default": "close_signal_next_open",
          "title": "Execution Protocol",
          "type": "string"
        },
        "initial_cash": {
          "default": 1000000.0,
          "exclusiveMinimum": 0.0,
          "title": "Initial Cash",
          "type": "number"
        },
        "lookback": {
          "default": 20,
          "minimum": 1,
          "title": "Lookback",
          "type": "integer"
        },
        "lot_sizes": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Lot Sizes",
          "type": "object"
        },
        "market_weight_overrides": {
          "additionalProperties": {
            "type": "number"
          },
          "propertyNames": {
            "enum": [
              "CN",
              "HK",
              "JP",
              "US"
            ]
          },
          "title": "Market Weight Overrides",
          "type": "object"
        },
        "max_asset_weight": {
          "default": 0.1,
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Max Asset Weight",
          "type": "number"
        },
        "max_episode_steps": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Episode Steps"
        },
        "max_leverage": {
          "default": 1.0,
          "maximum": 3.0,
          "minimum": 1.0,
          "title": "Max Leverage",
          "type": "number"
        },
        "max_market_weight": {
          "default": 0.4,
          "exclusiveMinimum": 0.0,
          "maximum": 3.0,
          "title": "Max Market Weight",
          "type": "number"
        },
        "max_turnover": {
          "default": 1.0,
          "maximum": 2.0,
          "minimum": 0.0,
          "title": "Max Turnover",
          "type": "number"
        },
        "reward": {
          "default": "risk_adjusted",
          "enum": [
            "log_return",
            "return_minus_cost",
            "risk_adjusted",
            "differential_sharpe",
            "drawdown_penalty",
            "cvar_penalty"
          ],
          "title": "Reward",
          "type": "string"
        },
        "risk_aversion": {
          "default": 0.1,
          "minimum": 0.0,
          "title": "Risk Aversion",
          "type": "number"
        },
        "slippage_bps": {
          "default": 5.0,
          "maximum": 1000.0,
          "minimum": 0.0,
          "title": "Slippage Bps",
          "type": "number"
        },
        "t_plus_one_markets": {
          "default": [
            "CN"
          ],
          "items": {
            "enum": [
              "CN",
              "HK",
              "JP",
              "US"
            ],
            "type": "string"
          },
          "title": "T Plus One Markets",
          "type": "array",
          "uniqueItems": true
        },
        "transaction_cost_bps": {
          "default": 10.0,
          "maximum": 1000.0,
          "minimum": 0.0,
          "title": "Transaction Cost Bps",
          "type": "number"
        }
      },
      "title": "EnvironmentConfig",
      "type": "object"
    },
    "HierarchicalDirective": {
      "additionalProperties": false,
