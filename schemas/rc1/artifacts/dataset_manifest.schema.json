{
  "$defs": {
    "ManifestFile": {
      "additionalProperties": false,
      "description": "Integrity and semantic metadata for one dataset artifact.",
      "properties": {
        "date_end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date End"
        },
        "date_start": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date Start"
        },
        "format": {
          "enum": [
            "csv",
            "parquet"
          ],
          "title": "Format",
          "type": "string"
        },
        "markets": {
          "items": {
            "type": "string"
          },
          "title": "Markets",
          "type": "array"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "role": {
          "enum": [
            "ohlcv",
            "instruments",
            "fx"
          ],
          "title": "Role",
          "type": "string"
        },
        "row_count": {
          "minimum": 0,
          "title": "Row Count",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "symbols": {
          "items": {
            "type": "string"
          },
          "title": "Symbols",
          "type": "array"
        }
      },
      "required": [
        "path",
        "role",
        "format",
        "size_bytes",
        "sha256",
        "row_count"
      ],
      "title": "ManifestFile",
      "type": "object"
    },
    "QualitySummary": {
      "additionalProperties": false,
      "description": "Aggregated validation status captured at import time.",
      "properties": {
        "error_count": {
          "minimum": 0,
          "title": "Error Count",
          "type": "integer"
        },
        "is_valid": {
          "title": "Is Valid",
          "type": "boolean"
        },
        "warning_count": {
          "minimum": 0,
          "title": "Warning Count",
          "type": "integer"
        }
      },
      "required": [
        "is_valid",
        "error_count",
        "warning_count"
      ],
      "title": "QualitySummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Reproducible metadata for a canonical dataset root.",
  "properties": {
    "adjustment_rule": {
      "title": "Adjustment Rule",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dataset_name": {
      "title": "Dataset Name",
      "type": "string"
    },
    "date_end": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Date End"
    },
    "date_start": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Date Start"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/ManifestFile"
      },
      "title": "Files",
      "type": "array"
    },
    "markets": {
      "items": {
        "type": "string"
      },
      "title": "Markets",
      "type": "array"
    },
    "quality": {
      "$ref": "#/$defs/QualitySummary"
    },
    "row_count": {
      "minimum": 0,
      "title": "Row Count",
      "type": "integer"
    },
    "schema_columns": {
      "items": {
        "type": "string"
      },
      "title": "Schema Columns",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "software_version": {
      "title": "Software Version",
      "type": "string"
    },
    "source": {
      "title": "Source",
      "type": "string"
    },
    "symbols": {
      "items": {
        "type": "string"
      },
      "title": "Symbols",
      "type": "array"
    }
  },
  "required": [
    "dataset_name",
    "created_at",
    "software_version",
    "source",
    "adjustment_rule",
    "row_count",
    "markets",
    "symbols",
    "date_start",
    "date_end",
    "schema_columns",
    "files",
    "quality"
  ],
  "title": "DatasetManifest",
  "type": "object"
}
