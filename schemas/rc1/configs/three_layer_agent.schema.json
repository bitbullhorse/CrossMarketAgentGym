          "anyOf": [
            {
              "$ref": "#/$defs/TeamSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "HierarchicalLayerConfig",
      "type": "object"
    },
    "LLMLayersConfig": {
      "additionalProperties": false,
      "description": "Three independently switchable layers.",
      "properties": {
        "hierarchical": {
          "$ref": "#/$defs/HierarchicalLayerConfig"
        },
        "research": {
          "$ref": "#/$defs/ResearchLayerConfig"
        },
        "risk": {
          "$ref": "#/$defs/RiskLayerConfig"
        }
      },
      "title": "LLMLayersConfig",
      "type": "object"
    },
    "MockTurn": {
      "additionalProperties": false,
