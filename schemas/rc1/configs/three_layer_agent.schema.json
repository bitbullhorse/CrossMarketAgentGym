          "title": "Tool Calls",
          "type": "array"
        },
        "usage": {
          "$ref": "#/$defs/TokenUsage"
        }
      },
      "title": "MockTurn",
      "type": "object"
    },
    "ResearchLayerConfig": {
      "additionalProperties": false,
